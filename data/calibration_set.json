{
  "schema_version": "1.0",
  "name": "SkillShift-Bench calibration subset",
  "what_this_is": "A fixed subset of 30 task families used to check that a local deployment of the benchmark websites behaves like the one the published numbers were produced on. `skillshift calibrate` runs the built-in no-skill reference agent over these families under all six conditions (30 x 6 = 180 runs) and compares the result with data/reference_results/.",
  "what_this_is_not": "Not a leaderboard split, not a dev set, and not a benchmark score. Its denominators (14 / 10 / 6) are not the benchmark's (162 / 114 / 79), and a number measured on it must never be reported as a SkillShift-Bench result. Tuning a method on these 30 families is measuring your own thermometer.",
  "id_kind": "family_id",
  "id_kind_note": "Family ids carry no site version on purpose: one calibration task is run under all six conditions, and src* loads the v1 task file while tgt* loads the v2 one. Pinning a uid such as 'skillshift.gitlab.v1.0' would lock only half of each family's grid.",
  "sampling": {
    "rule": "uniform-by-index-v1",
    "formula": "index_j = floor(j * n_tasks / k) for j = 0 .. k-1",
    "randomness": "none: the rule is deterministic and takes no seed",
    "n_tasks": {
      "gitlab": 162,
      "magento": 114,
      "wordpress": 79
    },
    "counts": {
      "gitlab": 14,
      "magento": 10,
      "wordpress": 6
    },
    "counts_rationale": "Roughly proportional to each site's share of the 355 tasks, rounded so that the smallest site still contributes a cell that can move at all.",
    "indices": {
      "gitlab": [
        0,
        11,
        23,
        34,
        46,
        57,
        69,
        81,
        92,
        104,
        115,
        127,
        138,
        150
      ],
      "magento": [
        0,
        11,
        22,
        34,
        45,
        57,
        68,
        79,
        91,
        102
      ],
      "wordpress": [
        0,
        13,
        26,
        39,
        52,
        65
      ]
    },
    "recompute": "for site, (n, k) in {'gitlab': (162, 14), 'magento': (114, 10), 'wordpress': (79, 6)}.items(): [f'skillshift.{site}.{j * n // k}' for j in range(k)]"
  },
  "conditions": [
    "src",
    "src-perc",
    "src-exec",
    "tgt",
    "tgt-perc",
    "tgt-exec"
  ],
  "n_families": 30,
